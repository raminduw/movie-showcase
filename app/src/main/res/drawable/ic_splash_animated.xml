<?xml version="1.0" encoding="utf-8"?>
<!-- Film frame drops in, then a heart "beats" inside it. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="frame"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.6"
                android:scaleY="0.6">
                <!-- film frame -->
                <path
                    android:fillColor="#FFE8505B"
                    android:pathData="M36,32h36a6,6 0,0 1,6 6v32a6,6 0,0 1,-6 6h-36a6,6 0,0 1,-6 -6v-32a6,6 0,0 1,6 -6z" />
                <!-- sprocket holes -->
                <path
                    android:fillColor="#FF0F1115"
                    android:pathData="M33,37h3v4h-3z M33,46h3v4h-3z M33,55h3v4h-3z M33,64h3v4h-3z M72,37h3v4h-3z M72,46h3v4h-3z M72,55h3v4h-3z M72,64h3v4h-3z" />
            </group>
            <group
                android:name="heart"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0"
                android:scaleY="0">
                <group
                    android:translateX="42"
                    android:translateY="42.5">
                    <path
                        android:fillColor="#FFFFFFFF"
                        android:pathData="M12,21.35l-1.45,-1.32C5.4,15.36 2,12.28 2,8.5 2,5.42 4.42,3 7.5,3c1.74,0 3.41,0.81 4.5,2.09C13.09,3.81 14.76,3 16.5,3 19.58,3 22,5.42 22,8.5c0,3.78 -3.4,6.86 -8.55,11.54L12,21.35z" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="frame">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="350"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0.6"
                    android:valueTo="1" />
                <objectAnimator
                    android:duration="350"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0.6"
                    android:valueTo="1" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="heart">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <set>
                    <objectAnimator
                        android:duration="300"
                        android:startOffset="300"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="scaleX"
                        android:valueFrom="0"
                        android:valueTo="1.25" />
                    <objectAnimator
                        android:duration="300"
                        android:startOffset="300"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="scaleY"
                        android:valueFrom="0"
                        android:valueTo="1.25" />
                </set>
                <set>
                    <objectAnimator
                        android:duration="250"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="scaleX"
                        android:valueFrom="1.25"
                        android:valueTo="1" />
                    <objectAnimator
                        android:duration="250"
                        android:interpolator="@android:interpolator/fast_out_slow_in"
                        android:propertyName="scaleY"
                        android:valueFrom="1.25"
                        android:valueTo="1" />
                </set>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
